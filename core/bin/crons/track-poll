#!/bin/bash
# track-poll — Auto Tracker due-queue poll, one pass.
#
# Runs TrackingScheduler.run_once against the real store: every shipment
# whose next_poll_at is due gets polled through its carrier pack, events
# append, milestones transition, terminal shipments auto-archive. The
# singleton lock (tracking_state 'scheduler:lock') makes overlapping runs
# harmless — a second pass exits immediately as {"locked": true}.
#
# NOTE: scheduler.py has no __main__ CLI yet (tracked as a follow-up), so
# this wrapper drives run_once via inline Python.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AOS_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
QAREEN_VENV="$HOME/.aos/services/qareen/.venv/bin/python"

if [ -x "$QAREEN_VENV" ]; then
    PYTHON="$QAREEN_VENV"
else
    PYTHON="$AOS_ROOT/core/bin/internal/aos-python"
fi

cd "$AOS_ROOT" || { echo "[track-poll] cannot cd to $AOS_ROOT" >&2; exit 1; }

ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "[track-poll] $(ts) polling due shipments"

"$PYTHON" - <<'PY'
import logging
import sys
from datetime import datetime, timezone

sys.path.insert(0, "core")

from qareen.tracking.packs import load_packs
from qareen.tracking.scheduler import TrackingScheduler
from qareen.tracking.store import ShipmentStore

logging.basicConfig(
    level=logging.INFO, format="%(levelname)s %(name)s: %(message)s"
)

store = ShipmentStore()  # ~/.aos/data/qareen.db, self-initializing
packs = load_packs()
scheduler = TrackingScheduler(store, packs)
now = datetime.now(timezone.utc).replace(tzinfo=None)
report = scheduler.run_once(now)
print(
    "track-poll: polled=%(polled)d transitions=%(transitions)d "
    "archived=%(archived)d locked=%(locked)s errors=%d"
    % (report, len(report.get("errors", [])))
)
PY
