#!/bin/bash
# track-poll — Auto Tracker due-queue poll, one pass.
#
# Runs TrackingScheduler.run_once against the real store: every shipment
# whose next_poll_at is due gets polled through its carrier pack, events
# append, milestones transition, terminal shipments auto-archive. The
# singleton lock (tracking_state 'scheduler:lock') makes overlapping runs
# harmless — a second pass exits immediately as {"locked": true}.
#
# This wrapper delegates to `python3 -m qareen.tracking.scheduler --once`.
# Do NOT reintroduce an inline copy of the run_once call here: the previous
# inline version drifted from scheduler.main() (broken format string, and no
# Notifier passed), and failed 23/23 runs while the module CLI was correct.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AOS_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
QAREEN_VENV="$HOME/.aos/services/qareen/.venv/bin/python"

if [ -x "$QAREEN_VENV" ]; then
    PYTHON="$QAREEN_VENV"
else
    PYTHON="$AOS_ROOT/core/bin/internal/aos-python"
fi

cd "$AOS_ROOT" || { echo "[track-poll] cannot cd to $AOS_ROOT" >&2; exit 1; }

ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "[track-poll] $(ts) polling due shipments"

PYTHONPATH="$AOS_ROOT/core${PYTHONPATH:+:$PYTHONPATH}" \
    "$PYTHON" -m qareen.tracking.scheduler --once
