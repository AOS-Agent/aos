#!/usr/bin/env bash
# nightly-pipeline — owns exactly the one nightly step nothing else runs:
# the DAILY friction report from session-analysis (Mon-Sat).
#
# Cron audit (2026-09-13, aos#240.3): this used to also re-run stale-detector
# (08:00's own standalone cron — stale-detector has since been retired
# outright, aos#240.2) and compile-daily (which has its own 23:30 cron).
# Running the same step from two crons on the same day was pure waste and
# left two "owners" for one output. One owner per step now:
#   - session-analysis DAILY mode  → owned solely by this pipeline (23:00)
#   - session-analysis WEEKLY mode → owned solely by its own cron (22:00 Sun)
#   - compile-daily                → owned solely by its own cron (23:30)
#
# On Sunday the standalone session-analysis cron already produced the WEEKLY
# report at 22:00, so this skips entirely rather than also writing a
# same-day daily one nobody asked for.
set -u

ts() { date +%H:%M:%S; }

echo "[$(ts)] nightly-pipeline starting"

DAY=$(date +%u)  # 1=Monday, 7=Sunday
if [ "$DAY" = "7" ]; then
    echo "Skipping session-analysis (Sunday — scheduler already ran the weekly version at 22:00)"
    echo "[$(ts)] nightly-pipeline done — nothing to run today"
    exit 0
fi

echo "Running daily session analysis..."
~/aos/core/bin/aos-python ~/aos/core/bin/session-analysis daily
rc=$?

if [ "$rc" -ne 0 ]; then
    echo "[$(ts)] nightly-pipeline FAILED (session-analysis exit $rc)" >&2
    exit 1
fi

echo "[$(ts)] nightly-pipeline done"
exit 0
