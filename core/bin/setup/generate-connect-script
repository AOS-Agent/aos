#!/usr/bin/env bash
# generate-connect-script — write a personalized "connect my other Mac to AOS"
# script to the given path (default: ~/Desktop/connect-to-aos.sh).
#
# Called by the onboard skill (Phase 4: Remote Access). The operator AirDrops
# the generated file to their laptop and runs it there; it installs Tailscale,
# adds an `ssh aos` Host block, and drops two double-clickable shortcuts on the
# laptop's Desktop.
#
# This machine's Tailscale IP, login user, hostname, and agent name are baked in
# at generation time, so the generated script needs no arguments and no
# knowledge of AOS.

# Always resolve Python through the AOS resolver — a python3 on PATH can be
# present, correctly versioned, and unusable (Homebrew 3.14's pyexpat).
AOS_PY="${AOS_PY:-$HOME/aos/core/bin/internal/aos-python}"
set -euo pipefail

OUT="${1:-$HOME/Desktop/connect-to-aos.sh}"

# ── Gather this machine's identity ───────────────────────────────────────────
TS_IP=""
if command -v tailscale &>/dev/null; then
    TS_IP=$(tailscale ip -4 2>/dev/null | head -1 || true)
fi
if [[ -z "$TS_IP" ]]; then
    echo "error: no Tailscale IPv4 address found." >&2
    echo "       Run 'tailscale up' and approve this device, then re-run." >&2
    exit 1
fi

TS_HOST=$(tailscale status --self --json 2>/dev/null \
    | "$AOS_PY" -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip(".").split(".")[0])' 2>/dev/null || true)
[[ -n "$TS_HOST" ]] || TS_HOST=$(scutil --get ComputerName 2>/dev/null || hostname -s)

SSH_USER=$(whoami)

AGENT_NAME=$("$AOS_PY" -c "
import yaml
try:
    with open('$HOME/.aos/config/operator.yaml') as f:
        print(yaml.safe_load(f).get('agent_name') or 'chief')
except Exception:
    print('chief')
" 2>/dev/null || echo chief)

mkdir -p "$(dirname "$OUT")"

# ── Emit the connect script ──────────────────────────────────────────────────
# Quoted heredoc: nothing below is expanded here. The values this machine
# resolved above are injected via the small unquoted block that follows.
{
cat <<'HEADER'
#!/usr/bin/env bash
# connect-to-aos — run this ON YOUR LAPTOP to reach your AOS machine.
# Generated by AOS. Safe to re-run; every step is idempotent.
set -euo pipefail
HEADER

cat <<VALUES

AOS_IP="$TS_IP"
AOS_HOST="$TS_HOST"
AOS_USER="$SSH_USER"
AGENT_NAME="$AGENT_NAME"
VALUES

cat <<'BODY'

say() { printf "  %s\n" "$*"; }

echo ""
echo "  Connecting this Mac to your AOS machine (${AOS_HOST})."
echo ""

# ── 1. Tailscale ─────────────────────────────────────────────────────────────
if command -v tailscale &>/dev/null; then
    say "Tailscale already installed."
else
    say "Installing Tailscale..."
    if command -v brew &>/dev/null; then
        brew install --cask tailscale
    else
        say "Homebrew not found — install Tailscale from https://tailscale.com/download"
        say "Then re-run this script."
        exit 1
    fi
fi

if ! tailscale status &>/dev/null; then
    say "Sign in to Tailscale with the SAME account you used on ${AOS_HOST}."
    open -a Tailscale 2>/dev/null || true
    read -r -p "  Press Enter once Tailscale says Connected... " _
fi

# ── 2. SSH shortcut ──────────────────────────────────────────────────────────
mkdir -p "$HOME/.ssh"
touch "$HOME/.ssh/config"
chmod 600 "$HOME/.ssh/config"

# aos#2334: a re-run used to see any existing `Host aos` block (marked or
# not) and leave it alone — so a changed Tailscale IP (new machine, new
# network) never landed, and the script still reported success. This
# idempotently replaces the managed block between marker comments, adding
# the markers if this is the first run, and never touches anything else in
# the file.
_write_aos_ssh_block() {
    local config="$HOME/.ssh/config"
    local begin="# >>> aos-connect: managed 'aos' host — do not edit between these lines >>>"
    local end="# <<< aos-connect: managed 'aos' host <<<"
    local block_file tmp
    # The replacement block is staged in its own file and spliced in via
    # awk's getline-from-file — NOT passed through `awk -v` as a multi-line
    # string, which BSD/"one true" awk (macOS's default /usr/bin/awk) rejects
    # outright ("newline in string") even though gawk tolerates it. A laptop
    # this script runs on is not guaranteed to have gawk.
    block_file=$(mktemp)
    cat > "$block_file" <<BLOCK
$begin
Host aos
    HostName ${AOS_IP}
    User ${AOS_USER}
    ServerAliveInterval 60
$end
BLOCK
    tmp=$(mktemp "${config}.XXXXXX")

    if grep -qF "$begin" "$config" 2>/dev/null; then
        # Marked block from a prior run of this script — replace it in
        # place so a changed IP actually lands. Everything else preserved.
        awk -v begin="$begin" -v end="$end" -v blockfile="$block_file" '
            $0 == begin {
                while ((getline line < blockfile) > 0) print line
                close(blockfile)
                skip=1; next
            }
            skip && $0 == end { skip=0; next }
            skip { next }
            { print }
        ' "$config" > "$tmp"
        say "Updated the 'aos' SSH config entry (picked up the current Tailscale IP)."
    elif grep -qE '^[[:space:]]*Host[[:space:]]+aos([[:space:]]|$)' "$config" 2>/dev/null; then
        # Unmarked `Host aos` block from an older connect-to-aos.sh —
        # replace it with the new marked block instead of leaving a stale,
        # unmanaged duplicate.
        awk -v blockfile="$block_file" '
            /^[[:space:]]*Host[[:space:]]+aos([[:space:]]|$)/ && !replaced {
                while ((getline line < blockfile) > 0) print line
                close(blockfile)
                in_block=1; replaced=1; next
            }
            in_block && /^[[:space:]]*Host[[:space:]]+/ { in_block=0 }
            in_block { next }
            { print }
        ' "$config" > "$tmp"
        say "Replaced an existing 'aos' SSH config entry with a managed one."
    else
        cp "$config" "$tmp"
        {
            echo ""
            cat "$block_file"
        } >> "$tmp"
        say "Added 'aos' to ~/.ssh/config — you can now run: ssh aos"
    fi

    rm -f "$block_file"
    mv "$tmp" "$config"
    chmod 600 "$config"
}
_write_aos_ssh_block

# ── 3. Desktop shortcuts ─────────────────────────────────────────────────────
TERM_CMD="$HOME/Desktop/AOS Terminal.command"
cat > "$TERM_CMD" <<TERMEOF
#!/usr/bin/env bash
exec ssh aos
TERMEOF
chmod +x "$TERM_CMD"
say "Created 'AOS Terminal' on your Desktop — double-click to connect."

# ── 4. Verify ────────────────────────────────────────────────────────────────
echo ""
if ssh -o BatchMode=yes -o ConnectTimeout=8 aos true 2>/dev/null; then
    say "Connected. ${AGENT_NAME} is reachable — try: ssh aos"
else
    say "Set up, but the first connection needs your approval."
    say "Run 'ssh aos' once and accept the host key."
fi
echo ""
BODY
} > "$OUT"

chmod +x "$OUT"

echo "Wrote $OUT"
echo "  machine : $TS_HOST ($TS_IP)"
echo "  ssh user: $SSH_USER"
echo "  agent   : $AGENT_NAME"
