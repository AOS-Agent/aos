#!/usr/bin/env python3
"""loop-eval — freeze, verify, and run the intelligence loop's eval gate.

Usage:
    loop-eval freeze <src_dir> [--version VERSION]
        Build MANIFEST.json in <src_dir> from its messages.jsonl and
        labels.jsonl (sha256 of each + row counts). <src_dir> becomes a
        frozen dataset — point AOS_LOOP_EVAL_DIR at it, or pass --dir.

    loop-eval verify [--dir DATASET_DIR]
        Recompute sha256 of messages.jsonl/labels.jsonl and confirm they
        still match MANIFEST.json. Exits 1 if the dataset has drifted.

    loop-eval run --judge-module <dotted.path:callable> [--dir DATASET_DIR]
        Import the judge callable, run it over the frozen dataset, print
        a markdown report, exit 1 if the gate fails.

Reads: <dataset_dir>/{messages.jsonl,labels.jsonl,MANIFEST.json}
Writes: <src_dir>/MANIFEST.json (freeze only)
"""

from __future__ import annotations

import argparse
import asyncio
import hashlib
import importlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

# Make both import styles work: `engine.loop.*` (core/ on path — see
# comms-recall) and `core.engine.loop.*` (repo root on path — see
# compile/llm.py's lazy-import dance). core/ is parents[2] of this file.
CORE_DIR = Path(__file__).resolve().parents[2]
REPO_ROOT = CORE_DIR.parent
for _p in (str(CORE_DIR), str(REPO_ROOT)):
    if _p not in sys.path:
        sys.path.insert(0, _p)

try:
    from engine.loop import eval_gate  # noqa: E402
except ImportError:
    from core.engine.loop import eval_gate  # noqa: E402


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    h.update(path.read_bytes())
    return h.hexdigest()


def _count_lines(path: Path) -> int:
    with path.open() as f:
        return sum(1 for line in f if line.strip())


def cmd_freeze(args: argparse.Namespace) -> int:
    src_dir = Path(args.src_dir)
    messages_path = src_dir / "messages.jsonl"
    labels_path = src_dir / "labels.jsonl"

    for p in (messages_path, labels_path):
        if not p.exists():
            print(f"error: missing {p}", file=sys.stderr)
            return 2

    # Preserve prior manifest fields (version note etc.) across re-freezes.
    manifest_path_prev = src_dir / "MANIFEST.json"
    prev = json.loads(manifest_path_prev.read_text()) if manifest_path_prev.exists() else {}

    manifest = {
        "version": args.version or prev.get("version", "v1"),
        "manifest_version": "1.0",
        "frozen_at": datetime.now(timezone.utc).isoformat(),
        "sha256": {
            "messages.jsonl": _sha256_file(messages_path),
            "labels.jsonl": _sha256_file(labels_path),
        },
        "counts": {
            "messages": _count_lines(messages_path),
            "labels": _count_lines(labels_path),
        },
    }
    if prev.get("note"):
        manifest["note"] = prev["note"]
    split_path = src_dir / "split.json"
    if split_path.exists():
        manifest["manifest_version"] = "1.2"
        manifest["sha256"]["split.json"] = _sha256_file(split_path)
        manifest["counts"]["split"] = json.loads(split_path.read_text())["counts"]

    manifest_path = src_dir / "MANIFEST.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
    print(f"froze {src_dir} -> {manifest_path}")
    print(json.dumps(manifest, indent=2))
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    dataset_dir = Path(args.dir) if args.dir else eval_gate.default_dataset_dir()
    try:
        eval_gate.verify_frozen(dataset_dir)
    except eval_gate.FrozenDatasetError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    print(f"ok: {dataset_dir} matches its MANIFEST.json")
    return 0


def _import_judge(dotted: str):
    if ":" not in dotted:
        raise ValueError(
            f"--judge-module must be 'dotted.path.to.module:callable_name', got {dotted!r}"
        )
    module_path, attr = dotted.split(":", 1)
    module = importlib.import_module(module_path)
    return getattr(module, attr)


def cmd_split(args: argparse.Namespace) -> int:
    """Generate a deterministic row-level stratified dev/test split.
    Strata = (label, machine_text); seed-shuffled within stratum; test
    gets ~22% per stratum with a floor of 2 for friction classes."""
    import random

    dataset_dir = Path(args.dir) if args.dir else eval_gate.default_dataset_dir()
    split_path = dataset_dir / "split.json"
    if split_path.exists() and not args.force:
        print(f"error: {split_path} exists (use --force to regenerate — "
              f"this invalidates every pass marker)", file=sys.stderr)
        return 1
    labels = []
    with (dataset_dir / "labels.jsonl").open() as fh:
        for line in fh:
            if line.strip():
                labels.append(json.loads(line))
    strata: dict[tuple, list] = {}
    for r in labels:
        strata.setdefault((r["label"], bool(r.get("machine_text"))), []).append(
            (r["session"], r["idx"])
        )
    total = len(labels)
    frac = args.test_size / total
    rng = random.Random(args.seed)
    test_keys = []
    for stratum, keys in sorted(strata.items()):
        keys = sorted(keys)
        rng.shuffle(keys)
        k = round(len(keys) * frac)
        label = stratum[0]
        if label != "none":
            k = max(k, min(2, len(keys)))  # floor of 2 for friction classes
        test_keys.extend(keys[:k])
    test_keys.sort()
    split_path.write_text(json.dumps({
        "split_version": "s1",
        "dataset": dataset_dir.name,
        "seed": args.seed,
        "method": "stratified-row(label,machine_text)",
        "counts": {"test": len(test_keys), "dev": total - len(test_keys)},
        "test": [list(k) for k in test_keys],
    }, indent=1))
    print(f"split.json written: test={len(test_keys)} dev={total - len(test_keys)}")
    print("now re-freeze: loop-eval freeze <dir>  (writes MANIFEST v1.2 incl. split hash)")
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    dataset_dir = Path(args.dir) if args.dir else None
    split = getattr(args, "split", "dev")
    if getattr(args, "record", False) and split != "test":
        print("error: --record is only valid with --split test (the pass marker "
              "certifies a held-out test pass, never dev/all)", file=sys.stderr)
        return 1
    judge_fn = _import_judge(args.judge_module)
    # Prefer the deployed pipeline (prefilter + batched judge) when the
    # judge's module exposes it — the gate must measure what ships.
    judge_module = importlib.import_module(args.judge_module.split(":", 1)[0])
    pipeline = getattr(judge_module, "classify_pipeline", None)

    thresholds = {}
    if args.machine_fp_max is not None:
        thresholds["machine_fp_max"] = args.machine_fp_max
    if args.binary_precision_min is not None:
        thresholds["binary_precision_min"] = args.binary_precision_min
    if args.binary_recall_min is not None:
        thresholds["binary_recall_min"] = args.binary_recall_min

    try:
        result = asyncio.run(eval_gate.run_gate(
            judge_fn if pipeline is None else None,
            dataset_dir=dataset_dir, thresholds=thresholds or None,
            split=split, pipeline=pipeline,
        ))
    except eval_gate.FrozenDatasetError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    print(eval_gate.format_report(result))
    if result.passed and getattr(args, "record", False):
        import json as _json
        from datetime import datetime, timezone

        try:
            from engine.loop import judge as _judge_mod
        except ImportError:
            from core.engine.loop import judge as _judge_mod
        marker = Path.home() / ".aos" / "data" / "loop" / "judge-gate-pass.json"
        marker.parent.mkdir(parents=True, exist_ok=True)
        ds = Path(dataset_dir or eval_gate.default_dataset_dir())
        manifest = _json.loads((ds / "MANIFEST.json").read_text())
        marker.write_text(_json.dumps({
            "judge_version": _judge_mod.version_hash(),
            "passed_at": datetime.now(timezone.utc).isoformat(),
            "dataset": str(ds),
            "manifest_version": str(manifest.get("manifest_version", "1.0")),
            "split": split,
            "split_sha256": manifest.get("sha256", {}).get("split.json"),
            "pipeline": {
                "batch_format": getattr(_judge_mod, "BATCH_FORMAT", None),
                "prefilter_version": getattr(_judge_mod, "PREFILTER_VERSION", None),
            },
            "metrics": result.metrics,
        }, indent=2, default=str))
        print(f"gate-pass marker written: {marker}")

    if split == "test":
        # Test-set burn guard: log every test run, warn past 3 per judge version.
        try:
            from engine.loop import judge as _jm
        except ImportError:
            from core.engine.loop import judge as _jm
        from datetime import datetime as _dt
        from datetime import timezone as _tz

        log = Path.home() / ".aos" / "data" / "loop" / "test-runs.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        jv = _jm.version_hash()
        with log.open("a") as fh:
            fh.write(json.dumps({"judge_version": jv, "at": _dt.now(_tz.utc).isoformat(),
                                 "passed": result.passed}) + "\n")
        runs = sum(1 for line in log.open() if json.loads(line)["judge_version"] == jv)
        if runs > 3:
            print(f"WARNING: {runs} test runs for judge {jv} — the test set is "
                  f"becoming a dev set. Iterate on --split dev.", file=sys.stderr)
    return 0 if result.passed else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Intelligence loop eval gate")
    sub = parser.add_subparsers(dest="command")

    fr = sub.add_parser("freeze", help="Build MANIFEST.json for a dataset directory")
    fr.add_argument("src_dir")
    fr.add_argument("--version", default=None, help="Dataset version label (default: keep existing)")

    ve = sub.add_parser("verify", help="Verify the frozen dataset hasn't drifted")
    ve.add_argument("--dir", default=None, help="Dataset dir (default: AOS_LOOP_EVAL_DIR or ~/vault/knowledge/references/loop-eval-v1)")

    sp = sub.add_parser("split", help="Generate stratified dev/test split.json (then re-freeze)")
    sp.add_argument("--dir", default=None)
    sp.add_argument("--seed", type=int, default=42)
    sp.add_argument("--test-size", type=int, default=200)
    sp.add_argument("--force", action="store_true")

    ru = sub.add_parser("run", help="Run a judge over the frozen dataset and report")
    ru.add_argument("--split", choices=["dev", "test", "all"], default="dev",
                    help="split to evaluate (default dev — iterate here; test only for --record)")
    ru.add_argument("--judge-module", required=True, help="dotted.path.to.module:callable")
    ru.add_argument("--record", action="store_true", help="on PASS, write the judge gate-pass marker")
    ru.add_argument("--dir", default=None, help="Dataset dir (default: AOS_LOOP_EVAL_DIR or ~/vault/knowledge/references/loop-eval-v1)")
    ru.add_argument("--machine-fp-max", type=int, default=None)
    ru.add_argument("--binary-precision-min", type=float, default=None)
    ru.add_argument("--binary-recall-min", type=float, default=None)

    args = parser.parse_args()

    if args.command == "freeze":
        return cmd_freeze(args)
    elif args.command == "verify":
        return cmd_verify(args)
    elif args.command == "split":
        return cmd_split(args)
    elif args.command == "run":
        return cmd_run(args)
    else:
        parser.print_help()
        return 2


if __name__ == "__main__":
    sys.exit(main())
